  "mission_inputs": {
    "surname_legend_li": {
      "key": "surname_legend_li",
      "name": "姓氏传说之“李”",
      "display_order": 1008,
      "difficulty": "advanced",
      "description": "话说商纣王当政时，理氏一族因直言进谏获罪，利贞随母亲四处逃难。母子断粮多日，幸得荒野中一株李树结满甘果，这才保住性命。为报救命之恩，利贞决定改“理”为“李”，谁知新姓氏刚取好，老仇家却追上了门。\n\n助纣为虐的恶来奉命赶尽杀绝，率领精兵封住去路，连那株救命的李树也不肯放过。附近百姓有心相助，却敌不过他的凶猛重戟，只得向各庄园求援。还请庄园主率领门客击退恶来，护住母子二人，让这段“木子成李”的传说得以流传。\n",
      "battle_type": "task1",
      "is_defense": false,
      "guest_only": false,
      "enemy_guests": [
