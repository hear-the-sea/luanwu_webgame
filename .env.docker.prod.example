# Docker Compose production environment example
#
# Usage:
#   cp .env.docker.prod.example .env.docker
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=luanwu.top
DJANGO_HEALTHCHECK_HOST=luanwu.top
DJANGO_CSRF_TRUSTED_ORIGINS=https://luanwu.top
# If you also serve www, append: ,www.luanwu.top / ,https://www.luanwu.top
CADDY_SITE_ADDRESS=luanwu.top
DJANGO_SECRET_KEY=please-change-me-in-production
DJANGO_USE_PROXY=1
# Set to your reverse-proxy IP(s) or CIDR(s), comma-separated.
# For Docker bridge networks, a common starting point is 172.16.0.0/12.
DJANGO_TRUSTED_PROXY_IPS=172.16.0.0/12
DJANGO_ACCESS_LOG_TRUST_PROXY=1
DJANGO_WEBSOCKET_MAX_CONNECTIONS_PER_USER=9
DJANGO_WEBSOCKET_CONNECTION_SLOT_TTL_SECONDS=30
DJANGO_WEBSOCKET_WORKER_LEASE_TTL_SECONDS=8
DJANGO_WEBSOCKET_WORKER_LEASE_HEARTBEAT_SECONDS=2
DJANGO_WEBSOCKET_MAX_CONNECTIONS_PER_IP=20
DJANGO_WEBSOCKET_HANDSHAKE_RATE_PER_SECOND=10
DJANGO_WEBSOCKET_HANDSHAKE_BURST=20
DJANGO_WEBSOCKET_IP_CONNECTION_SLOT_TTL_SECONDS=120

# Transactional email (Resend SMTP)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-resend-api-key
DEFAULT_FROM_EMAIL=noreply@mail.luanwu.top
EMAIL_MONTHLY_SEND_LIMIT=3000
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_IP_LIMIT=5
EMAIL_VERIFICATION_RESEND_IP_WINDOW_SECONDS=3600

# Virtual-player Arena safety bootstrap. A small healthy population may have
# a high shortage ratio; the early-game rule requires repeated healthy windows
# and reserve supply before accepting that ratio as its baseline.
DJANGO_ARENA_SHORTAGE_COLD_START_MAX_REAL_ENTRIES=2
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_MIN_MATURE_WINDOWS=3
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_MAX_RATIO=0.25
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_EARLY_GAME_MAX_REAL_ENTRIES=10
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_EARLY_GAME_MAX_RATIO=1.0
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_TTL_HOURS=168
DJANGO_VIRTUAL_PLAYER_SAFETY_AUTO_RESUME_CLEAN_WINDOWS=3
DJANGO_VIRTUAL_PLAYER_HEALTH_FAILURE_THRESHOLD=3
DJANGO_VIRTUAL_PLAYER_HEALTH_COOLDOWN_SECONDS=1800
DJANGO_VIRTUAL_PLAYER_HEALTH_RECOVERY_PROBE_SECONDS=60
DJANGO_VIRTUAL_PLAYER_HEALTH_RECOVERY_SUCCESS_THRESHOLD=2

# docker-compose.prod.yml's bundled Caddy owns ports 80/443, obtains and renews
# certificates automatically, and forwards X-Forwarded-Proto=https to Django.
# Keep this enabled in production. The domain above must resolve to this server.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database (MySQL in docker-compose.prod.yml)
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=webgame
DJANGO_DB_USER=webgame
DJANGO_DB_PASSWORD=change-me-strong-db-password
DJANGO_DB_HOST=db
DJANGO_DB_PORT=3306

# Redis (docker-compose.prod.yml)
REDIS_URL=redis://redis:6379
REDIS_CHANNEL_URL=redis://redis:6379/1
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2

# Required by docker-compose.prod.yml and Django's production infrastructure checks.
REDIS_PASSWORD=change-me-strong-redis-password

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DEFAULT_QUEUE=default
CELERY_BATTLE_QUEUE=battle
CELERY_TIMER_QUEUE=timer
CELERY_TIMER_SCAN_QUEUE=timer_scan
CELERY_TIMER_MAINTENANCE_QUEUE=timer_maintenance
# 4GB same-host initial baseline
CELERY_DEFAULT_CONCURRENCY=1
CELERY_BATTLE_CONCURRENCY=1
CELERY_TIMER_CONCURRENCY=1
CELERY_TIMER_SCAN_CONCURRENCY=1
CELERY_TIMER_MAINTENANCE_CONCURRENCY=1
CELERY_PREFETCH_MULTIPLIER=1
# Initial 4GB same-host estimate; keep all five queues at one prefork child
# until target-host RSS, swap and queue SLO measurements justify an increase.
CELERY_MAX_TASKS_PER_CHILD=200
CELERY_MAX_MEMORY_PER_CHILD=180000

# Compose cgroup guardrails. These are a starting budget, not proof of target
# host capacity; tune only with RSS/OOM/swap measurements from the deployment host.
REDIS_MEMORY_LIMIT=128m
REDIS_MEMORY_RESERVATION=64m
MYSQL_MEMORY_LIMIT=768m
MYSQL_MEMORY_RESERVATION=512m
WEB_MEMORY_LIMIT=384m
WEB_MEMORY_RESERVATION=256m
CELERY_WORKER_MEMORY_LIMIT=256m
CELERY_WORKER_MEMORY_RESERVATION=160m
CELERY_BEAT_MEMORY_LIMIT=96m
CELERY_BEAT_MEMORY_RESERVATION=64m
CADDY_MEMORY_LIMIT=64m
CADDY_MEMORY_RESERVATION=32m

# MySQL/Redis low-memory guards. Redis uses noeviction so broker messages are
# not silently discarded; cache pressure must be observed and handled.
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_MAX_CONNECTIONS=40
MYSQL_TMP_TABLE_SIZE=16M
MYSQL_MAX_HEAP_TABLE_SIZE=16M
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=noeviction

# Startup behavior
DJANGO_RUN_MIGRATIONS=0
DJANGO_SYNC_GUEST_TEMPLATES=0
DJANGO_GUEST_TEMPLATES_FILE=data/guest_templates.yaml
DJANGO_GUEST_HEROES_DIR=data/guests
DJANGO_GUEST_TEMPLATES_SKIP_IMAGES=0
# In docker-compose.prod.yml, web uses read_only: true and writes collected assets
# through the ./runtime/staticfiles:/app/staticfiles volume. Chown runtime dirs
# to UID/GID 10001:10001 before first startup; see docs/runbook_deploy_docker.md.
DJANGO_COLLECTSTATIC=1
DJANGO_STATIC_USE_MANIFEST=1
DJANGO_WAIT_FOR_DB_SECONDS=60
DJANGO_WAIT_FOR_REDIS_SECONDS=60
DJANGO_HEALTH_CHECK_CHANNEL_LAYER=1
DJANGO_HEALTH_CHECK_CELERY_BROKER=1
DJANGO_HEALTH_CHECK_CELERY_WORKERS=1
DJANGO_HEALTH_CHECK_CELERY_BEAT=1
DJANGO_HEALTH_CHECK_CELERY_ROUNDTRIP=1

# Observability
DJANGO_ACCESS_LOG=1

# App image tag loaded by `docker load`
WEBGAME_IMAGE=webgame:v1
