# Docker Compose production environment example
#
# Usage:
#   cp .env.docker.prod.example .env.docker
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=luanwu.top
DJANGO_HEALTHCHECK_HOST=luanwu.top
DJANGO_CSRF_TRUSTED_ORIGINS=https://luanwu.top
# If you also serve www, append: ,www.luanwu.top / ,https://www.luanwu.top
CADDY_SITE_ADDRESS=luanwu.top
DJANGO_SECRET_KEY=please-change-me-in-production
DJANGO_USE_PROXY=1
# Set to your reverse-proxy IP(s) or CIDR(s), comma-separated.
# For Docker bridge networks, a common starting point is 172.16.0.0/12.
DJANGO_TRUSTED_PROXY_IPS=172.16.0.0/12
DJANGO_ACCESS_LOG_TRUST_PROXY=1
DJANGO_WEBSOCKET_MAX_CONNECTIONS_PER_USER=9
DJANGO_WEBSOCKET_CONNECTION_SLOT_TTL_SECONDS=30
DJANGO_WEBSOCKET_WORKER_LEASE_TTL_SECONDS=8
DJANGO_WEBSOCKET_WORKER_LEASE_HEARTBEAT_SECONDS=2
DJANGO_WEBSOCKET_MAX_CONNECTIONS_PER_IP=20
DJANGO_WEBSOCKET_HANDSHAKE_RATE_PER_SECOND=10
DJANGO_WEBSOCKET_HANDSHAKE_BURST=20
DJANGO_WEBSOCKET_IP_CONNECTION_SLOT_TTL_SECONDS=120

# docker-compose.prod.yml's bundled Caddy owns ports 80/443, obtains and renews
# certificates automatically, and forwards X-Forwarded-Proto=https to Django.
# Keep this enabled in production. The domain above must resolve to this server.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database (MySQL in docker-compose.prod.yml)
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=webgame
DJANGO_DB_USER=webgame
DJANGO_DB_PASSWORD=change-me-strong-db-password
DJANGO_DB_HOST=db
DJANGO_DB_PORT=3306

# Redis (docker-compose.prod.yml)
REDIS_URL=redis://redis:6379
REDIS_CHANNEL_URL=redis://redis:6379/1
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2

# Required by docker-compose.prod.yml and Django's production infrastructure checks.
REDIS_PASSWORD=change-me-strong-redis-password

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DEFAULT_QUEUE=default
CELERY_BATTLE_QUEUE=battle
CELERY_TIMER_QUEUE=timer
# 4C8G baseline
CELERY_DEFAULT_CONCURRENCY=1
CELERY_BATTLE_CONCURRENCY=2
CELERY_TIMER_CONCURRENCY=1
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=300

# Startup behavior
DJANGO_RUN_MIGRATIONS=0
DJANGO_SYNC_GUEST_TEMPLATES=0
DJANGO_GUEST_TEMPLATES_FILE=data/guest_templates.yaml
DJANGO_GUEST_HEROES_DIR=data/guests
DJANGO_GUEST_TEMPLATES_SKIP_IMAGES=0
# In docker-compose.prod.yml, web uses read_only: true and writes collected assets
# through the ./runtime/staticfiles:/app/staticfiles volume. Chown runtime dirs
# to UID/GID 10001:10001 before first startup; see docs/runbook_deploy_docker.md.
DJANGO_COLLECTSTATIC=1
DJANGO_STATIC_USE_MANIFEST=1
DJANGO_WAIT_FOR_DB_SECONDS=60
DJANGO_WAIT_FOR_REDIS_SECONDS=60
DJANGO_HEALTH_CHECK_CHANNEL_LAYER=1
DJANGO_HEALTH_CHECK_CELERY_BROKER=1
DJANGO_HEALTH_CHECK_CELERY_WORKERS=1
DJANGO_HEALTH_CHECK_CELERY_BEAT=1
DJANGO_HEALTH_CHECK_CELERY_ROUNDTRIP=1

# Observability
DJANGO_ACCESS_LOG=1

# App image tag loaded by `docker load`
WEBGAME_IMAGE=webgame:v1
