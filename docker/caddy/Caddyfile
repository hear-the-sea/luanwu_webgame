{
	servers {
		# Empty by default; only explicitly configured upstream proxies are trusted.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	log {
		output stdout
		format json
	}

	@hashed_static path_regexp hashed_static ^/static/.+\.[0-9a-f]{12}\..+$
	handle @hashed_static {
		uri strip_prefix /static
		root * /srv/staticfiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /static/* {
		root * /srv/staticfiles
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		# Preserve forwarded client IPs only from the trusted upstream proxies above.
		reverse_proxy web:8000
	}
}
