{
  "name": "web-game-v5",
  "version": "1.0.0",
  "description": "春秋乱世庄园主 - 古风武侠游戏",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css",
    "check:css": "npm run build:css && git diff --exit-code -- static/css/tailwind.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --watch",
    "build:css:prod": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --minify",
    "check:js": "find static/js -maxdepth 1 -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:js": "node --test static/js/tests/*.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16"
  }
}
