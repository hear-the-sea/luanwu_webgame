# Docker Compose development environment example
#
# Usage:
#   cp .env.docker.example .env.docker
#   docker compose up --build

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=please-change-me-in-docker
DJANGO_USE_PROXY=0
DJANGO_STATIC_USE_MANIFEST=0
DJANGO_SYNC_GUEST_TEMPLATES=0
DJANGO_GUEST_TEMPLATES_FILE=data/guest_templates.yaml
DJANGO_GUEST_HEROES_DIR=data/guests
DJANGO_GUEST_TEMPLATES_SKIP_IMAGES=1
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_ACCESS_LOG_TRUST_PROXY=0

# Transactional email (development uses the console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery, remove the line above and configure Resend as primary:
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=replace-with-resend-api-key
# DEFAULT_FROM_EMAIL=noreply@mail.example.com
# Resend uses the EMAIL_* values above as its primary SMTP configuration.
EMAIL_RESEND_DAILY_SEND_LIMIT=100
# Brevo secondary SMTP (use an SMTP key, not an API key).
# BREVO_EMAIL_HOST=smtp-relay.brevo.com
# BREVO_EMAIL_PORT=587
# BREVO_EMAIL_USE_TLS=1
# BREVO_EMAIL_USE_SSL=0
# BREVO_EMAIL_HOST_USER=your-brevo-login@example.com
# BREVO_EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
EMAIL_BREVO_DAILY_SEND_LIMIT=300
EMAIL_MONTHLY_SEND_LIMIT=4000
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_IP_LIMIT=20
EMAIL_VERIFICATION_RECOVERY_EMAIL_LIMIT=10
EMAIL_VERIFICATION_RESEND_IP_WINDOW_SECONDS=3600

DJANGO_WEBSOCKET_MAX_CONNECTIONS_PER_USER=9
DJANGO_WEBSOCKET_CONNECTION_SLOT_TTL_SECONDS=30
DJANGO_WEBSOCKET_WORKER_LEASE_TTL_SECONDS=8
DJANGO_WEBSOCKET_WORKER_LEASE_HEARTBEAT_SECONDS=2
DJANGO_HEALTH_CHECK_CHANNEL_LAYER=1
DJANGO_HEALTH_CHECK_CHANNEL_LAYER_TIMEOUT_SECONDS=5

# Virtual-player Arena safety bootstrap. These defaults are safe for a new
# server and can be tuned only after reviewing repeated safety windows.
DJANGO_ARENA_SHORTAGE_COLD_START_MAX_REAL_ENTRIES=2
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_MIN_MATURE_WINDOWS=3
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_MAX_RATIO=0.25
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_EARLY_GAME_MAX_REAL_ENTRIES=10
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_EARLY_GAME_MAX_RATIO=1.0
DJANGO_ARENA_SHORTAGE_BASELINE_BOOTSTRAP_TTL_HOURS=168
DJANGO_VIRTUAL_PLAYER_SAFETY_AUTO_RESUME_CLEAN_WINDOWS=3
DJANGO_VIRTUAL_PLAYER_HEALTH_FAILURE_THRESHOLD=3
DJANGO_VIRTUAL_PLAYER_HEALTH_COOLDOWN_SECONDS=1800
DJANGO_VIRTUAL_PLAYER_HEALTH_RECOVERY_PROBE_SECONDS=60
DJANGO_VIRTUAL_PLAYER_HEALTH_RECOVERY_SUCCESS_THRESHOLD=2

# Arena low-population scheduling and scoped safety are explicit deployment
# choices. Keep low-population acceleration disabled until the full Web,
# worker and Beat fleet is ready; set it to 1 only when the deployment has
# been reviewed for the target population. These keys make the effective
# defaults visible without changing the safe default.
VIRTUAL_PLAYER_ARENA_SAFETY_POLICY=scoped
ARENA_LOW_POPULATION_MODE=0
ARENA_LOW_POPULATION_WAIT_SECONDS=900
ARENA_LOW_POPULATION_COOP_WAIT_SECONDS=1800
ARENA_FILL_SERVICE_RETENTION_DAYS=90
VIRTUAL_PLAYER_SAFETY_AUDIT_RETENTION_DAYS=180

# Database (MySQL in docker-compose.yml)
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=webgame
DJANGO_DB_USER=webgame
DJANGO_DB_PASSWORD=xxxxxxxxxx
DJANGO_DB_HOST=db
DJANGO_DB_PORT=3306

# Redis (docker-compose.yml)
REDIS_URL=redis://redis:6379
REDIS_CHANNEL_URL=redis://redis:6379/1
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2

# Optional: enable Redis AUTH (recommended if you expose Redis beyond the docker network)
# If set, docker-compose.yml will start Redis with --requirepass and services should use REDIS_PASSWORD.
REDIS_PASSWORD=
# Bound Redis connect/read/write waits (seconds) for cache, channels and Celery.
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_CHANNEL_SOCKET_TIMEOUT=10

#CELERY_BROKER_URL=redis://redis:6379/0
#CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DEFAULT_QUEUE=default
CELERY_BATTLE_QUEUE=battle
CELERY_TIMER_QUEUE=timer
CELERY_TIMER_SCAN_QUEUE=timer_scan
CELERY_TIMER_MAINTENANCE_QUEUE=timer_maintenance
CELERY_TIMER_SAFETY_QUEUE=timer_safety
CELERY_TIMER_SCAN_CONCURRENCY=2
CELERY_TIMER_MAINTENANCE_CONCURRENCY=1
CELERY_TIMER_SAFETY_CONCURRENCY=1
CELERY_TIMER_SAFETY_MEMORY_LIMIT=512m
CELERY_TIMER_SAFETY_MEMORY_RESERVATION=256m
CELERY_TIMER_SAFETY_MAX_MEMORY_PER_CHILD=400000

# Optional: make startup waits longer on slower machines
DJANGO_WAIT_FOR_DB_SECONDS=60
DJANGO_WAIT_FOR_REDIS_SECONDS=60
